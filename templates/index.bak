<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Booking Converter</title>
<link rel="stylesheet" href="{{ url_for('static', filename='css/main.scss') }}">
</head>
<body>

<header>
  <div class="wordmark">Booking <em>Converter</em></div>
  <div class="tagline">PDF Itinerary → Quotations Database</div>
  <div class="rule"></div>
</header>

<div class="card">
  <form id="upload-form" method="POST" action="/upload" enctype="multipart/form-data">

    <div id="dropzone">
      <input type="file" name="pdf" id="file-input" accept=".pdf">
      <span class="dz-icon">📄</span>
      <span class="dz-label">Drop booking PDF here</span>
      <span class="dz-sub">or click to browse</span>
    </div>

    <div id="file-pill">
      <span class="pill-icon">📎</span>
      <span class="pill-name" id="pill-name"></span>
      <button type="button" class="pill-remove" id="pill-remove" aria-label="Remove file">✕</button>
    </div>

    <button type="submit" id="submit-btn" disabled>Extract &amp; Review</button>
  </form>

  {% if error %}
  <div class="error-box">⚠ {{ error }}</div>
  {% endif %}
</div>

<footer>Powered by Claude AI</footer>

<script src="{{ url_for('static', filename='js/index.js') }}"></script>

</body>
</html>
